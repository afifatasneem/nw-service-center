{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authorized staff and owner accounts for NW Service Center",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["Owner", "Staff", "Technician"] },
        "passwordHash": { "type": "string", "maxLength": 128 },
        "salt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "fullName", "role", "passwordHash", "status"]
    },
    "Job": {
      "title": "Job",
      "description": "Welding machine repair job card",
      "type": "object",
      "properties": {
        "jobNumber": { "type": "string", "maxLength": 20 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 20 },
        "machineId": { "type": "string", "maxLength": 60 },
        "machineBrand": { "type": "string", "maxLength": 50 },
        "machineModel": { "type": "string", "maxLength": 50 },
        "serialNumber": { "type": "string", "maxLength": 50 },
        "machineType": { "type": "string", "maxLength": 50 },
        "customerComplaint": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["Received", "Under Repair", "Waiting for Parts", "Waiting for Customer Approval", "Repaired", "Ready for Collection", "Dispatched"] },
        "technicianId": { "type": "string", "maxLength": 50 },
        "technicianName": { "type": "string", "maxLength": 100 },
        "receivedDate": { "type": "string", "maxLength": 50 },
        "expectedCompletionDate": { "type": "string", "maxLength": 50 },
        "expectedDeliveryDate": { "type": "string", "maxLength": 50 },
        "repairCharges": { "type": "number" },
        "advance": { "type": "number" },
        "balance": { "type": "number" },
        "paymentDueDate": { "type": "string", "maxLength": 50 },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Partially Paid", "Pending"] },
        "monthPeriod": { "type": "string", "maxLength": 10 },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["jobNumber", "customerName", "customerPhone", "machineBrand", "status", "monthPeriod"]
    },
    "CustomerMachine": {
      "title": "CustomerMachine",
      "description": "Welding machine registered under a customer",
      "type": "object",
      "properties": {
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 20 },
        "machineBrand": { "type": "string", "maxLength": 50 },
        "machineModel": { "type": "string", "maxLength": 50 },
        "serialNumber": { "type": "string", "maxLength": 50 },
        "machineType": { "type": "string", "maxLength": 50 },
        "photoUrl": { "type": "string" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["customerName", "customerPhone", "machineBrand"]
    },
    "SpareItem": {
      "title": "SpareItem",
      "description": "Welding machine spare parts inventory record",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "currentStock": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "totalAdded": { "type": "number" },
        "totalUsed": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "category", "currentStock", "minStockAlert"]
    },
    "SpareTransaction": {
      "title": "SpareTransaction",
      "description": "Spare stock addition or consumption record",
      "type": "object",
      "properties": {
        "itemId": { "type": "string", "maxLength": 50 },
        "itemName": { "type": "string", "maxLength": 100 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["IN", "OUT"] },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "supplierOrSource": { "type": "string", "maxLength": 100 },
        "jobNumber": { "type": "string", "maxLength": 50 },
        "technician": { "type": "string", "maxLength": 100 },
        "reason": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 300 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["itemId", "itemName", "type", "quantity", "previousStock", "newStock", "timestamp"]
    },
    "Technician": {
      "title": "Technician",
      "description": "Staff and technician details",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "mobile": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "status"]
    },
    "MachineBrand": {
      "title": "MachineBrand",
      "description": "Welding machine brand",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "status"]
    },
    "MonthlyClosing": {
      "title": "MonthlyClosing",
      "description": "Monthly accounting and job audit closing",
      "type": "object",
      "properties": {
        "monthPeriod": { "type": "string", "maxLength": 10 },
        "monthName": { "type": "string", "maxLength": 50 },
        "closedAt": { "type": "string", "maxLength": 50 },
        "closedBy": { "type": "string", "maxLength": 100 },
        "totalJobsReceived": { "type": "number" },
        "totalJobsRepaired": { "type": "number" },
        "totalDispatched": { "type": "number" },
        "totalPendingJobs": { "type": "number" },
        "totalRepairCollection": { "type": "number" },
        "totalPendingAmount": { "type": "number" },
        "totalPaymentsReceived": { "type": "number" },
        "totalPartsUsed": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["monthPeriod", "monthName", "closedAt", "closedBy"]
    },
    "BusinessSetting": {
      "title": "BusinessSetting",
      "description": "Business profile and configuration",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 250 },
        "isOwnerConfigured": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["businessName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Staff and owner user accounts"
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "Job cards for welding machine repairs"
    },
    "/customer_machines/{machineId}": {
      "schema": { "$ref": "#/entities/CustomerMachine" },
      "description": "Machines registered under customers"
    },
    "/spare_items/{itemId}": {
      "schema": { "$ref": "#/entities/SpareItem" },
      "description": "Spare parts inventory list"
    },
    "/spare_transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/SpareTransaction" },
      "description": "Spare stock addition and deduction logs"
    },
    "/technicians/{technicianId}": {
      "schema": { "$ref": "#/entities/Technician" },
      "description": "Service technicians list"
    },
    "/machine_brands/{brandId}": {
      "schema": { "$ref": "#/entities/MachineBrand" },
      "description": "Machine brand dropdown options"
    },
    "/monthly_closings/{closingId}": {
      "schema": { "$ref": "#/entities/MonthlyClosing" },
      "description": "Archive records of monthly closings"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSetting" },
      "description": "System settings and metadata"
    }
  }
}
